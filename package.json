{
  "name": "is-this-chess",
  "description": "Is this chess? You upload an image. Cutting-edge AI tells you if it's chess. That's it.",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "astro check && astro build",
    "dev": "astro dev",
    "format": "prettier --write  \"**/*.{json,ts,mjs,cjs,md,astro}\" \"**/.*.{json,ts,mjs,cjs,md,astro}\"",
    "format:check": "prettier --check  \"**/*.{json,ts,mjs,cjs,md,astro}\" \"**/.*.{json,ts,mjs,cjs,md,astro}\"",
    "lint": "eslint \"**/*.{ts,mjs,cjs,astro}\" \"**/.*.{ts,mjs,cjs,astro}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,mjs,cjs,astro}\" \"**/.*.{ts,mjs,cjs,astro}\"",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "pnpm run lint && pnpm run format && pnpm run build",
    "typecheck": "astro check --typescript"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.3",
    "@astrojs/netlify": "^6.0.0",
    "@astrojs/solid-js": "^5.0.0",
    "@solid-primitives/upload": "^0.1.3",
    "astro": "^5.16.6",
    "openai": "^6.15.0",
    "solid-js": "^1.9.4",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.51.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
